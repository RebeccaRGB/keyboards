<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE keyCapLayout PUBLIC "-//Kreative//DTD KreativeKeyCaps 1.0//EN" "http://www.kreativekorp.com/dtd/kkcx.dtd">
<keyCapLayout name="Goldtouch Numeric Keypad" cc="1" lc="31" a="w">
	<k x="0u" y="5u"><l>Esc</l><l type="FF" a="c">MC</l></k>
	<k><l>Tab</l><l type="FF" a="c">MR</l></k>
	<k><l>Back&#10;Space</l><l type="FF" a="c">MS</l></k>
	<k>Shift/Fn</k>
	<k x="0u" y="4u"><l>Num&#10;Lock</l><l type="FF" a="c">$</l></k>
	<k><l>/</l><l type="FF" a="c">&#8364;</l></k>
	<k><l>*</l><l type="FF" a="c">&#163;</l></k>
	<k><l>-</l><l type="FF" a="c">&#165;</l></k>
	<k x="0u" y="3u" type="N"><l>7</l><l>Home</l><l type="FF" a="c">&#162;</l></k>
	<k type="N"><l>8</l><l>&#8593;</l><l type="FF" a="c">%</l></k>
	<k type="N"><l>9</l><l>PgUp</l><l type="FF" a="c">+/&#8722;</l></k>
	<k x="0u" y="2u" type="N"><l>4</l><l>&#8592;</l><l type="FF" a="c">(</l></k>
	<k type="N"><l>5</l><l type="FF" a="c">)</l></k>
	<k type="N"><l>6</l><l>&#8594;</l><l type="FF" a="c">\</l></k>
	<k shape="1+2u"><l>+</l><l type="FF" a="c">M+</l></k>
	<k x="0u" y="1u" type="N"><l>1</l><l>End</l><l type="FF" a="c">:</l></k>
	<k type="N"><l>2</l><l>&#8595;</l><l type="FF" a="c">@</l></k>
	<k type="N"><l>3</l><l>PgDn</l><l type="FF" a="c">#</l></k>
	<k x="0u" y="0u" type="N"><l>0</l><l>Insert</l></k>
	<k type="N"><l>00</l><l type="FF" a="c">,</l></k>
	<k type="N"><l>.</l><l>Del</l><l type="FF" a="c">Del</l></k>
	<k shape="1+2u"><l>Enter</l><l type="FF" a="c">=</l></k>
</keyCapLayout>
